{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-cloud-pricing-sk01"
		},
		"ls_adls_cloudpricing_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stcloudpricingsk01.dfs.core.windows.net/"
		},
		"ls_rest_azure_retail_prices_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://prices.azure.com/api/retail/prices"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/pl_ingest_azure_retail_prices')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "set_run_id",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "run_id",
							"value": {
								"value": "@concat(formatDateTime(pipeline().TriggerTime,'yyyyMMdd'),'T',formatDateTime(pipeline().TriggerTime,'HHmmss'),'Z')",
								"type": "Expression"
							}
						}
					},
					{
						"name": "foreach_region",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "set_run_id",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@pipeline().parameters.regions",
								"type": "Expression"
							},
							"isSequential": true,
							"activities": [
								{
									"name": "copy_region_prices",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 2,
										"retryIntervalInSeconds": 60,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "RestSource",
											"httpRequestTimeout": "00:01:40",
											"requestInterval": "00.00:00:00.010",
											"requestMethod": "GET",
											"paginationRules": {
												"AbsoluteUrl": {
													"value": "$.NextPageLink",
													"type": "Expression"
												}
											}
										},
										"sink": {
											"type": "JsonSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "JsonWriteSettings",
												"filePattern": "setOfObjects"
											}
										},
										"enableStaging": false
									},
									"inputs": [
										{
											"referenceName": "ds_rest_azure_retail_prices",
											"type": "DatasetReference",
											"parameters": {
												"relative_url": {
													"value": "@concat('?api-version=2023-01-01-preview&currencyCode=%27USD%27&$filter=', uriComponent(concat('serviceName eq ''Virtual Machines'' and armRegionName eq ''', item(), '''', if(empty(pipeline().parameters.sku_filter), '', concat(' and armSkuName eq ''', pipeline().parameters.sku_filter, '''')))))",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "ds_adls_landing_json",
											"type": "DatasetReference",
											"parameters": {
												"folder_path": {
													"value": "@concat('azure_retail/run_date=', formatDateTime(pipeline().TriggerTime,'yyyy-MM-dd'), '/run_id=', variables('run_id'), '/', item())",
													"type": "Expression"
												},
												"file_name": "prices.json"
											}
										}
									]
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"regions": {
						"type": "array",
						"defaultValue": [
							"centralindia",
							"eastus"
						]
					},
					"sku_filter": {
						"type": "string"
					}
				},
				"variables": {
					"run_id": {
						"type": "String"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_rest_azure_retail_prices')]",
				"[concat(variables('factoryId'), '/datasets/ds_adls_landing_json')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_adls_landing_json')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_adls_cloudpricing",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"folder_path": {
						"type": "string"
					},
					"file_name": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "Json",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@dataset().file_name",
							"type": "Expression"
						},
						"folderPath": {
							"value": "@dataset().folder_path",
							"type": "Expression"
						},
						"fileSystem": "landing"
					}
				},
				"schema": {}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_adls_cloudpricing')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_rest_azure_retail_prices')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_rest_azure_retail_prices",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"relative_url": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "RestResource",
				"typeProperties": {
					"relativeUrl": {
						"value": "@dataset().relative_url",
						"type": "Expression"
					}
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_rest_azure_retail_prices')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_adls_cloudpricing')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('ls_adls_cloudpricing_properties_typeProperties_url')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_rest_azure_retail_prices')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "RestService",
				"typeProperties": {
					"url": "[parameters('ls_rest_azure_retail_prices_properties_typeProperties_url')]",
					"enableServerCertificateValidation": true,
					"authenticationType": "Anonymous"
				}
			},
			"dependsOn": []
		}
	]
}