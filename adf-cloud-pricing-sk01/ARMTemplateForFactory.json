{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-cloud-pricing-sk01"
		},
		"ls_adls_cloudpricing_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stcloudpricingsk01.dfs.core.windows.net/"
		},
		"ls_http_aws_pricing_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://pricing.us-east-1.amazonaws.com/offers/v1.0/aws/AmazonEC2/"
		},
		"ls_rest_azure_management_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://management.azure.com/"
		},
		"ls_rest_azure_management_properties_typeProperties_aadResourceId": {
			"type": "string",
			"defaultValue": "https://management.azure.com/"
		},
		"ls_rest_azure_retail_prices_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://prices.azure.com/api/retail/prices"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/pl_daily_load')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "run_azure_ingest",
						"type": "ExecutePipeline",
						"dependsOn": [],
						"policy": {
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "pl_ingest_azure_retail_prices",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {
								"regions": {
									"value": "@createArray('centralindia', 'eastus')",
									"type": "Expression"
								}
							}
						}
					},
					{
						"name": "run_aws_ingest",
						"type": "ExecutePipeline",
						"dependsOn": [],
						"policy": {
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "pl_ingest_aws_ec2_prices",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {
								"regions": {
									"value": "@createArray('ap-south-1', 'us-east-1')",
									"type": "Expression"
								}
							}
						}
					},
					{
						"name": "run_daily_price_load",
						"type": "DatabricksJob",
						"state": "Inactive",
						"onInactiveMarkAs": "Succeeded",
						"dependsOn": [
							{
								"activity": "run_azure_ingest",
								"dependencyConditions": [
									"Succeeded"
								]
							},
							{
								"activity": "run_aws_ingest",
								"dependencyConditions": [
									"Completed"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 1,
							"retryIntervalInSeconds": 300,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"jobId": "270931804839819"
						},
						"linkedServiceName": {
							"referenceName": "ls_databricks_cloudpricing",
							"type": "LinkedServiceReference"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/pipelines/pl_ingest_azure_retail_prices')]",
				"[concat(variables('factoryId'), '/pipelines/pl_ingest_aws_ec2_prices')]",
				"[concat(variables('factoryId'), '/linkedServices/ls_databricks_cloudpricing')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_ingest_aws_ec2_prices')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "get_region_index",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "JsonSource",
								"storeSettings": {
									"type": "HttpReadSettings",
									"requestMethod": "GET"
								},
								"formatSettings": {
									"type": "JsonReadSettings"
								}
							},
							"dataset": {
								"referenceName": "ds_http_aws_json",
								"type": "DatasetReference",
								"parameters": {
									"relative_url": "current/region_index.json"
								}
							}
						}
					},
					{
						"name": "set_aws_version",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "get_region_index",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "aws_version",
							"value": {
								"value": "@split(activity('get_region_index').output.firstRow.regions['ap-south-1'].currentVersionUrl, '/')[5]",
								"type": "Expression"
							}
						}
					},
					{
						"name": "foreach_aws_region",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "set_aws_version",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@pipeline().parameters.regions",
								"type": "Expression"
							},
							"isSequential": true,
							"activities": [
								{
									"name": "check_already_landed",
									"type": "GetMetadata",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"dataset": {
											"referenceName": "ds_adls_landing_binary",
											"type": "DatasetReference",
											"parameters": {
												"folder_path": "@concat('aws_ec2/version=', variables('aws_version'), '/', item())",
												"file_name": "index.csv"
											}
										},
										"fieldList": [
											"exists"
										],
										"storeSettings": {
											"type": "AzureBlobFSReadSettings",
											"recursive": true,
											"enablePartitionDiscovery": false
										},
										"formatSettings": {
											"type": "BinaryReadSettings"
										}
									}
								},
								{
									"name": "if_not_landed",
									"type": "IfCondition",
									"dependsOn": [
										{
											"activity": "check_already_landed",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"userProperties": [],
									"typeProperties": {
										"expression": {
											"value": "@not(activity('check_already_landed').output.exists)",
											"type": "Expression"
										},
										"ifTrueActivities": [
											{
												"name": "copy_aws_region_file",
												"type": "Copy",
												"dependsOn": [],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 3,
													"retryIntervalInSeconds": 300,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"source": {
														"type": "BinarySource",
														"storeSettings": {
															"type": "HttpReadSettings",
															"requestMethod": "GET"
														},
														"formatSettings": {
															"type": "BinaryReadSettings"
														}
													},
													"sink": {
														"type": "BinarySink",
														"storeSettings": {
															"type": "AzureBlobFSWriteSettings"
														}
													},
													"enableStaging": false
												},
												"inputs": [
													{
														"referenceName": "ds_http_aws_file",
														"type": "DatasetReference",
														"parameters": {
															"relative_url": "@concat(variables('aws_version'), '/', item(), '/index.csv')"
														}
													}
												],
												"outputs": [
													{
														"referenceName": "ds_adls_landing_binary",
														"type": "DatasetReference",
														"parameters": {
															"folder_path": "@concat('aws_ec2/version=', variables('aws_version'), '/', item())",
															"file_name": "index.csv"
														}
													}
												]
											}
										]
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"regions": {
						"type": "array",
						"defaultValue": [
							"ap-south-1",
							"us-east-1"
						]
					}
				},
				"variables": {
					"aws_version": {
						"type": "String"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_http_aws_json')]",
				"[concat(variables('factoryId'), '/datasets/ds_adls_landing_binary')]",
				"[concat(variables('factoryId'), '/datasets/ds_http_aws_file')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_ingest_azure_retail_prices')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
