							"variableName": "run_id",
							"value": {
								"value": "@concat(formatDateTime(pipeline().TriggerTime,'yyyyMMdd'),'T',formatDateTime(pipeline().TriggerTime,'HHmmss'),'Z')",
								"type": "Expression"
							}
						}
					},
					{
						"name": "foreach_region",
						"type": "ForEach",
