{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-cloud-pricing-sk01"
		},
		"ls_adls_cloudpricing_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stcloudpricingsk01.dfs.core.windows.net/"
		},
		"ls_http_aws_pricing_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://pricing.us-east-1.amazonaws.com/offers/v1.0/aws/AmazonEC2/"
		},
		"ls_rest_azure_management_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://management.azure.com/"
		},
		"ls_rest_azure_management_properties_typeProperties_aadResourceId": {
			"type": "string",
			"defaultValue": "https://management.azure.com/"
		},
		"ls_rest_azure_retail_prices_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://prices.azure.com/api/retail/prices"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-cloud-pricing-sk01_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adls_cloudpricing_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_cloudpricing_properties_typeProperties_url')]"
					},
					"ls_http_aws_pricing_properties_typeProperties_url": {
						"value": "[parameters('ls_http_aws_pricing_properties_typeProperties_url')]"
					},
					"ls_rest_azure_management_properties_typeProperties_url": {
						"value": "[parameters('ls_rest_azure_management_properties_typeProperties_url')]"
					},
					"ls_rest_azure_management_properties_typeProperties_aadResourceId": {
						"value": "[parameters('ls_rest_azure_management_properties_typeProperties_aadResourceId')]"
					},
					"ls_rest_azure_retail_prices_properties_typeProperties_url": {
						"value": "[parameters('ls_rest_azure_retail_prices_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}